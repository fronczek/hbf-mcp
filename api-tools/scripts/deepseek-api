#!/usr/bin/env python3
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

API_URL = "https://api.deepseek.com/chat/completions"
DEFAULT_MODEL = "deepseek-flash"
CREDENTIALS_DIR = Path(os.environ.get("HBF_CREDENTIALS_DIR", str(Path.home() / ".credentials"))).expanduser()
KEY_FILE = CREDENTIALS_DIR / "deepseek.txt"


def fail(message: str, code: int = 1) -> None:
    print(f"deepseek: {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="deepseek",
        description="Small DeepSeek API helper. Prompt may come from arguments, stdin, or both.",
        epilog='Examples:\n  deepseek "Explain this error"\n  git diff | deepseek "Review this diff"\n  deepseek --model deepseek-v4-pro --thinking "Plan this refactor"',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("prompt", nargs="*", help="prompt/instruction")
    p.add_argument("-m", "--model", default=DEFAULT_MODEL,
                   choices=["deepseek-flash", "deepseek-v4-pro"])
    p.add_argument("-s", "--system", help="optional system message")
    p.add_argument("-t", "--thinking", action="store_true",
                   help="enable thinking mode (default: disabled)")
    p.add_argument("--effort", choices=["none", "low", "high", "max"],
                   help="reasoning effort; implies thinking unless set to none")
    p.add_argument("--max-tokens", type=int, help="maximum completion tokens")
    p.add_argument("--usage", action="store_true",
                   help="print token usage to stderr")
    p.add_argument("--raw", action="store_true",
                   help="print full JSON response instead of answer text")
    return p.parse_args()


def build_user_content(args: argparse.Namespace) -> str:
    instruction = " ".join(args.prompt).strip()
    piped = ""
    if not sys.stdin.isatty():
        piped = sys.stdin.read()

    if instruction and piped:
        return f"{instruction}\n\n--- INPUT ---\n{piped}"
    if instruction:
        return instruction
    if piped:
        return piped
    fail("no prompt provided (use arguments or pipe text on stdin)", 2)
    return ""


def main() -> None:
    args = parse_args()

    try:
        mode = KEY_FILE.stat().st_mode & 0o777
    except FileNotFoundError:
        fail(f"API key file not found: {KEY_FILE}")
    if mode & 0o077:
        fail(f"refusing to use {KEY_FILE}: permissions are {mode:o}, expected 600 or stricter")

    api_key = KEY_FILE.read_text(encoding="utf-8").strip()
    if not api_key:
        fail(f"API key file is empty: {KEY_FILE}")

    messages = []
    if args.system:
        messages.append({"role": "system", "content": args.system})
    messages.append({"role": "user", "content": build_user_content(args)})

    effort = args.effort
    if effort is None:
        effort = "high" if args.thinking else "none"
    thinking_enabled = effort != "none"

    payload = {
        "model": args.model,
        "messages": messages,
        "thinking": {"type": "enabled" if thinking_enabled else "disabled"},
        "reasoning_effort": effort,
        "stream": False,
    }
    if args.max_tokens is not None:
        if args.max_tokens < 1:
            fail("--max-tokens must be >= 1", 2)
        payload["max_tokens"] = args.max_tokens

    request = urllib.request.Request(
        API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": "hbf-deepseek-helper/1.0",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=300) as response:
            result = json.load(response)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body)
            detail = detail.get("error", {}).get("message") or body
        except json.JSONDecodeError:
            detail = body
        fail(f"API HTTP {exc.code}: {detail}")
    except urllib.error.URLError as exc:
        fail(f"API connection failed: {exc.reason}")

    if args.raw:
        json.dump(result, sys.stdout, ensure_ascii=False, indent=2)
        print()
    else:
        try:
            content = result["choices"][0]["message"]["content"]
        except (KeyError, IndexError, TypeError):
            fail("unexpected API response (use --raw for details)")
        if content is not None:
            print(content)

    if args.usage:
        usage = result.get("usage", {})
        model = result.get("model", args.model)
        print(
            f"[deepseek] model={model} prompt={usage.get('prompt_tokens', '?')} "
            f"completion={usage.get('completion_tokens', '?')} total={usage.get('total_tokens', '?')}",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
