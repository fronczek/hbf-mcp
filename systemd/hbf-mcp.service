[Unit]
Description=HBF MCP bridge (@SERVICE_NAME@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@INSTALL_DIR@
Environment=HBF_MCP_AGENT_HOME=@AGENT_HOME@
Environment=HBF_MCP_SERVICE_NAME=@SERVICE_NAME@
EnvironmentFile=@INSTALL_DIR@/.env
ExecStart=@INSTALL_DIR@/.venv/bin/python @INSTALL_DIR@/server.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
