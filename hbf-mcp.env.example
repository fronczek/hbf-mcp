HBF_MCP_NAME=HBF MCP - Artur
HBF_MCP_HOST=0.0.0.0
HBF_MCP_PORT=8765
HBF_MCP_DEFAULT_CWD=/home/gptagent

# Directories the file tools may read and write. Colon-separated (os.pathsep).
# Both default to HBF_MCP_DEFAULT_CWD.
HBF_MCP_READ_ROOTS=/home/gptagent
HBF_MCP_WRITE_ROOTS=/home/gptagent

# Credential files that read_secret_file may return. Empty by design: credential
# access has to be granted deliberately, one path at a time. Colon-separated.
HBF_MCP_SECRET_READ_ALLOWLIST=

# Log sources read_logs may touch. Services without a file mapping are read with
# journalctl; service=file pairs override that with a plain log file.
HBF_MCP_ALLOWED_LOG_SERVICES=hbf-mcp
HBF_MCP_LOG_FILES=
HBF_MCP_MAX_LOG_LINES=1000
HBF_MCP_MAX_LOG_BYTES=262144

HBF_MCP_SHELL_TIMEOUT=120
HBF_MCP_COMMAND_TIMEOUT=30
HBF_MCP_MAX_OUTPUT=524288

# Fixed read-only helper used by kuk_boiler_watch (takes no user input).
HBF_MCP_BOILER_HELPER=/home/gptagent/bin/kuk-boiler-watch
